#version 460 core
#extension GL_ARB_separate_shader_objects : enable
#extension GL_ARB_shading_language_420pack : enable

// Simplified Loss + Backward for base color optimization
// Compares downsampled GT with LR directly (no UV tape needed)

// Input textures
layout(set = 0, binding = 0) uniform texture2D uGTTexture;     // GT texture (downsampled to LR size)
layout(set = 0, binding = 1) uniform texture2D uLRTexture;     // LR texture (current optimization target)
layout(set = 0, binding = 2) uniform sampler uSampler;

// Output images
layout(set = 0, binding = 3, rgba32f) uniform image2D uGradientImage;

// Push constant
layout(push_constant, std430) uniform uPushConstant {
    vec2 texSize;       // Texture size (LR size)
};

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    
    // Boundary check
    if (pixelCoord.x >= int(texSize.x) || pixelCoord.y >= int(texSize.y)) {
        return;
    }
    
    // Read GT and LR colors
    vec2 uv = (vec2(pixelCoord) + 0.5) / texSize;
    vec4 gtColor = textureLod(sampler2D(uGTTexture, uSampler), uv, 0.0);
    vec4 lrColor = textureLod(sampler2D(uLRTexture, uSampler), uv, 0.0);
    
    // MSE Loss: L = sum((lr - gt)^2)
    // dL/d(lr) = 2 * (lr - gt)
    vec4 d_loss = 2.0 * (lrColor - gtColor);
    
    // Store gradient
    imageStore(uGradientImage, pixelCoord, d_loss);
}